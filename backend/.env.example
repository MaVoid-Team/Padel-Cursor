# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=padel_booking
DB_USER=postgres
DB_PASSWORD=your_password_here

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here-change-in-production

# Paymob Payment Gateway Configuration
# Get these from your Paymob dashboard: https://accept.paymob.com/portal2/en/login
PAYMOB_API_KEY=your_paymob_api_key_here
PAYMOB_INTEGRATION_ID=your_paymob_integration_id_here
PAYMOB_IFRAME_ID=your_paymob_iframe_id_here
PAYMOB_HMAC_SECRET=your_paymob_hmac_secret_here

# Optional: CORS Configuration
# CORS_ORIGIN=http://localhost:3000

# Optional: Rate Limiting
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
