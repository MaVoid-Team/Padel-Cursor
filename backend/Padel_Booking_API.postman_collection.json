{
	"info": {
		"_postman_id": "padel-booking-api-2024",
		"name": "Padel Booking System API - Phase 2",
		"description": "Complete API collection for Padel Court Booking System with PostgreSQL backend.\n\nBase URL: http://localhost:3000\n\nFeatures:\n- Public booking endpoints with duration-aware conflict detection\n- Dynamic court management with pricing\n- Payment integration (Paymob + Manual)\n- Admin authentication with JWT\n- Full CRUD operations for bookings, courts, and payments\n- Statistics and analytics\n\nDefault Admin Credentials:\n- Username: admin\n- Password: admin123\n\nDate Format: YYYY-MM-DD (e.g., 2024-10-05)\nTime Format: HH:MM 24-hour (e.g., 14:30)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Health & Status",
			"item": [
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/health",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"health"
							]
						},
						"description": "Check if the API is running and healthy"
					},
					"response": []
				}
			],
			"description": "Health check and status endpoints"
		},
		{
			"name": "Public - Bookings",
			"item": [
				{
					"name": "Get Bookings for Date",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/bookings/{{testDate}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"bookings",
								"{{testDate}}"
							]
						},
						"description": "Get all confirmed bookings for a specific date.\n\nDate format: YYYY-MM-DD\n\nReturns: court_id, time, duration for each confirmed booking"
					},
					"response": []
				},
				{
					"name": "Create Booking",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    const response = pm.response.json();",
									"    if (response.booking && response.booking.id) {",
									"        pm.environment.set('lastBookingId', response.booking.id);",
									"        pm.test('Booking created successfully', function() {",
									"            pm.expect(response.success).to.be.true;",
									"        });",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"court_id\": 1,\n  \"date\": \"{{testDate}}\",\n  \"time\": \"14:00\",\n  \"duration\": 60,\n  \"player_name\": \"John Doe\",\n  \"player_email\": \"john.doe@example.com\",\n  \"player_phone\": \"555-0123\",\n  \"player_level\": \"Intermediate\",\n  \"additional_players\": 1,\n  \"special_requests\": \"Please prepare the court 10 minutes early\",\n  \"price\": 25.00\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/bookings",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"bookings"
							]
						},
						"description": "Create a new court booking with duration-aware conflict detection.\n\nRequired fields:\n- court_id (1-3)\n- date (YYYY-MM-DD format)\n- time (HH:MM 24-hour format)\n- duration (60, 90, or 120 minutes)\n- player_name\n- player_email\n\nOptional fields:\n- player_phone\n- player_level (Beginner, Intermediate, Advanced)\n- additional_players (0-3)\n- special_requests\n- price\n\nConflict Detection:\n- Checks for overlapping bookings considering duration\n- Returns 409 error if time slot conflicts with existing booking"
					},
					"response": []
				}
			],
			"description": "Public endpoints for viewing and creating bookings"
		},
		{
			"name": "Admin - Authentication",
			"item": [
				{
					"name": "Admin Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.token) {",
									"        pm.environment.set('adminToken', response.token);",
									"        pm.test('Login successful', function() {",
									"            pm.expect(response.success).to.be.true;",
									"        });",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/admin/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"admin",
								"login"
							]
						},
						"description": "Authenticate as admin user.\n\nDefault credentials:\n- Username: admin\n- Password: admin123\n\nReturns JWT token valid for 24 hours.\n\nToken is automatically saved to {{adminToken}} variable."
					},
					"response": []
				}
			],
			"description": "Admin authentication endpoints"
		},
